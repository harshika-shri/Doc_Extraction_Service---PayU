POSTGRES_USER=db
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=PayU_db
DATABASE_URL=postgresql+asyncpg://db:change-me@postgres:5432/PayU_db

JWT_SECRET_KEY=replace-with-a-secure-random-value
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

LLAMA_CLOUD_API_KEY=replace-with-llama-cloud-key
GEMINI_API_KEY=replace-with-gemini-key
GROQ_API_KEY=replace-with-groq-key
GROQ_LLM_MODEL=llama-3.1-8b-instant
GROQ_LLM_MAX_TOKENS=8192
